# Contact form (app/api/contact/route.ts). If RESEND_API_KEY is not set at
# build time, the form is hidden and only mailto/tel links are shown.
RESEND_API_KEY=
# Optional overrides
CONTACT_TO_EMAIL=youssefsahih9@gmail.com
# With Resend's shared sender, mail is only delivered to the Resend account's
# own address. Verify a domain in Resend to use your own sender.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
